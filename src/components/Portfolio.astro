---
import { portfolioSlides } from '../data/portfolio';
import { projects } from '../data/projects';

const projectMap = Object.fromEntries(projects.map(p => [p.id, p]));
---
<div class="portfolio py-5 container minh600" id="portfolio">
    <h1 class="heading text-center">Portfolio</h1>
    <h2 class="subheading text-center mb-0 mb-sm-5">Most recent work</h2>

    <!-- Modals for each slide (reuses project data) -->
    <div id="portfolio-modals">
        {portfolioSlides.map((slide) => {
            const project = projectMap[slide.id];
            if (!project) return null;
            return (
                <>
                    <!-- Read More Modal -->
                    <div class="modal modal1 fade" id={`readMorePortfolio${slide.id}`} tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5">{project.name}</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <img src={project.thumbnail} class="w-100" alt={project.name} />
                                    <div class="mt-4" set:html={project.description} />
                                    <div class="mt-3">
                                        <span class="text-theme fw-bold">Technologies used</span>
                                        <ul style="list-style-type:disc;">
                                            {project.techStack.map(tech => <li>{tech}</li>)}
                                        </ul>
                                    </div>
                                    {project.liveUrl && (
                                        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-lg d-block my-4 mx-auto">
                                            Visit Website
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- View Screens Modal -->
                    <div class="modal modal2 fade" id={`viewScreensPortfolio${slide.id}`} tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5">{project.name} Screens</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div id={`portfolioCarousel${slide.id}`} class="carousel slide" data-bs-ride="carousel">
                                        <div class="carousel-inner">
                                            {project.screens.map((screen, idx) => (
                                                <div class={`carousel-item${idx === 0 ? ' active' : ''}`}>
                                                    <img src={screen.src} class="d-block mx-auto maxh400" alt={screen.alt} />
                                                </div>
                                            ))}
                                        </div>
                                        <button class="carousel-control-prev" type="button" data-bs-target={`#portfolioCarousel${slide.id}`} data-bs-slide="prev">
                                            <i class="icon-arrow-left" aria-hidden="true"></i>
                                            <span class="visually-hidden">Previous</span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target={`#portfolioCarousel${slide.id}`} data-bs-slide="next">
                                            <i class="icon-arrow-right" aria-hidden="true"></i>
                                            <span class="visually-hidden">Next</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </>
            );
        })}
    </div>

    <!-- Swiper Carousel -->
    <div class="row py-4 mt-0 mt-sm-5 px-0 mb-0 center">
        <div class="col-12 col-xl-10 px-0">
            <div class="py-4 swiper portfolio-swiper px-0 mb-0">
                <div class="swiper-wrapper pb-0 pb-sm-4" id="portfolio-wrapper">
                    {portfolioSlides.map((slide) => (
                        <div class="swiper-slide w-100">
                            <div class="da-card">
                                <div class="row px-0">
                                    <div class="col-12 col-lg-6">
                                        <div class="img-container center">
                                            <img src={slide.image} class="d-block poster"
                                                alt={`Portfolio Rishav Jha ${slide.name}`} />
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6">
                                        <div class="description">
                                            <h1 class="heading">{slide.name}</h1>
                                            <h6 class="subheading mb-4 text-muted">{slide.subtitle}</h6>
                                            <p class="text fs-6">{slide.description}</p>
                                        </div>
                                        <div class="around">
                                            <button class="btn active" type="button"
                                                data-bs-toggle="modal"
                                                data-bs-target={`#readMorePortfolio${slide.id}`}>
                                                <a href="#">Read More</a>
                                            </button>
                                            <button class="btn" type="button"
                                                data-bs-toggle="modal"
                                                data-bs-target={`#viewScreensPortfolio${slide.id}`}>
                                                <a href="#">View Screens</a>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </div>
</div>

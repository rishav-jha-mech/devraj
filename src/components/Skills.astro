---
import { skillGroups } from '../data/skills';

const accordionIds = ['a1', 'a2', 'a3', 'a4'];
const collapseIds = ['flush-collapseOne', 'flush-collapseTwo', 'flush-collapseThree', 'flush-collapseFour'];
const headingIds = ['flush-headingOne', 'flush-headingTwo', 'flush-headingThree', 'flush-headingFour'];
---
<div class="skills minh525 container" id="skills">
    <h1 class="heading text-center">Skills</h1>
    <h2 class="subheading text-center mb-5">My technical level</h2>
    <div class="row mx-0 center">
        <div class="col-12 col-lg-11">
            <div class="row px-0 mx-0">
                {skillGroups.map((group, i) => (
                    <div class="accordion col-12 col-lg-6 accordion-flush" id={accordionIds[i]}>
                        <div class="accordion-item">
                            <h2 class="accordion-header" id={headingIds[i]}>
                                <button class="accordion-button" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target={`#${collapseIds[i]}`}
                                    aria-expanded="true"
                                    aria-controls={collapseIds[i]}>
                                    <div class="icon">
                                        {group.icon === 'svg-backend' ? (
                                            <div class="me-3" style="transform: scale(1.4);">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                                    <path fill="var(--theme-color)" d="M8,3A2,2 0 0,0 6,5V9A2,2 0 0,1 4,11H3V13H4A2,2 0 0,1 6,15V19A2,2 0 0,0 8,21H10V19H8V14A2,2 0 0,0 6,12A2,2 0 0,0 8,10V5H10V3M16,3A2,2 0 0,1 18,5V9A2,2 0 0,0 20,11H21V13H20A2,2 0 0,0 18,15V19A2,2 0 0,1 16,21H14V19H16V14A2,2 0 0,1 18,12A2,2 0 0,1 16,10V5H14V3H16Z" />
                                                </svg>
                                            </div>
                                        ) : (
                                            <i class={`${group.icon} text-theme fs-4 me-3`}></i>
                                        )}
                                    </div>
                                    <div class="text">
                                        {group.title}
                                        <h6 class="sec-text fw-light text-muted">{group.subtitle}</h6>
                                    </div>
                                </button>
                            </h2>
                            <div id={collapseIds[i]} class="accordion-collapse collapse show"
                                aria-labelledby={headingIds[i]} data-bs-parent={`#${accordionIds[i]}`}>
                                <div class="accordion-body">
                                    {group.skills.map((skill) => {
                                        const skillId = skill.name.replace(/\s+/g, '_');
                                        return (
                                            <div class="skill">
                                                <div class="skill-item">
                                                    <div class="between">
                                                        <div class="left"><h6>{skill.name}</h6></div>
                                                        <div class="right">
                                                            <h6 class="title">{skill.percentage}%</h6>
                                                        </div>
                                                    </div>
                                                    <progress id={skillId} class="w-100"
                                                        data-value={skill.percentage}
                                                        value={skill.percentage}
                                                        max="100">
                                                    </progress>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</div>

<div class="home minh625 container center" id="home">
    <div class="row mx-0 center">
        <div class="col-12 col-lg-11 px-0 mx-0">
            <div class="d-flex flex-column-reverse flex-lg-row">
                <div class="left text-center text-lg-start mt-1 mt-sm-0">
                    <div class="details">
                        <h1 class="heading text-dark d-flex align-items-center justify-content-center justify-content-lg-start">
                            Hi I'am Rishav <capsule><i class="fa-solid fa-code"></i></capsule>
                        </h1>
                        <p class="subheading mb-2 mb-sm-4" id="whatido">Frontend Developer</p>
                        <div class="text text-dark mb-3">
                            Experienced full-stack developer with expertise in building responsive and
                            user-friendly websites, cross-platform mobile apps, UI/UX designs and DevOps.
                        </div>
                        <div class="btn-container">
                            <button class="btn outline-btn mt-2 mt-sm-5" onclick="scrollToFunc('contact')">
                                Contact me <i class="fa-solid fa-angle-right fs-6 ml-3"></i>
                            </button>
                            <button class="btn mt-2 ml-3 mt-sm-5" onclick="window.downloadCv()">
                                Download CV <i class="bi bi-download fs-6 ml-3"></i>
                            </button>
                        </div>
                    </div>

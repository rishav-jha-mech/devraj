---
interface Service {
    title: string;
    description: string;
    icon: string; // Bootstrap icon class
}

const services: Service[] = [
    {
        title: 'Web Development',
        description: 'Full-stack web apps with React on the frontend and Django, Express, or Flask on the backend — from MVP to production.',
        icon: 'bi-layout-text-window-reverse',
    },
    {
        title: 'Mobile & Desktop Apps',
        description: 'Cross-platform apps for Android, iOS, and desktop using React Native, Flutter, Tauri, and Electron.',
        icon: 'bi-phone',
    },
    {
        title: 'UI/UX Design',
        description: 'Clean, responsive interfaces designed in Figma — focused on usability across devices, not just aesthetics.',
        icon: 'bi-palette',
    },
    {
        title: 'AI Integration',
        description: 'LLM-powered features built into your product — RAG pipelines, knowledge bases, and conversational tooling.',
        icon: 'bi-cpu',
    },
];
---
<div class="services minh525 container" id="services">
    <h1 class="heading text-center">Services</h1>
    <h2 class="subheading text-center mb-5">What I Do</h2>
    <div class="row mx-0 center">
        {services.map((service) => (
            <div class="col-lg-3 col-md-6 col-12 mb-4">
                <div class="card">
                    <div class="card-body">
                        <div class="icon-container">
                            <i class={`fs-1 bi ${service.icon}`}></i>
                        </div>
                        <h5 class="text-center mb-3">{service.title}</h5>
                        <article class="text-center">{service.description}</article>
                    </div>
                </div>
            </div>
        ))}
    </div>
</div>

---
import { projects } from '../data/projects';

const webProjects  = projects.filter(p => p.category === 'web');
const appProjects  = projects.filter(p => p.category === 'app');
const gameProjects = projects.filter(p => p.category === 'game');
---
<div class="projects container minh600" id="projects">
    <h1 class="heading text-center" id="my-projects">My Projects</h1>
    <h2 class="subheading text-center mb-5">What i made so far</h2>

    <div class="center my-3" id="togBtns">
        <button id="web-btn" onclick="showProjects('web')" class="btn my-2 my-sm-0">
            <i class="icon-globe"></i> Web Dev
        </button>
        <button id="app-btn" onclick="showProjects('app')" class="btn my-active mx-0 mx-sm-2 my-2 my-sm-0">
            <i class="fa-solid fa-mobile-screen"></i> App Dev
        </button>
        <button id="game-btn" onclick="showProjects('game')" class="btn my-2 my-sm-0">
            <i class="fa-solid fa-gamepad"></i> Game Dev
        </button>
    </div>

    <div class="py-4 row center mt-5 px-0 mb-0" id="project-grid">
        <div class="col-12 col-lg-10">

            <!-- Web Projects -->
            <div id="web-dev-projects" class="row px-0 d-none mx-0">
                {webProjects.map((project) => (
                    <>
                        <div class="col-12 col-md-6 col-lg-6 col-xl-4 mb-3">
                            <div class="project-item card rounded-5"
                                data-ribbon={project.ribbon}
                                style="--d:6px;--f:10px;--c:var(--theme-color)">
                                <div class="card-body">
                                    <div class="project-image">
                                        <img src={project.thumbnail} width="100%" height="100%"
                                            class="d-block w-100" alt={project.name} />
                                    </div>
                                    <div class="overlay project-description">
                                        <h6 class="fw-bold text-white">{project.name}</h6>
                                        <p class="mt-3 text-white">{project.tagline}</p>
                                        <div class="around btn-containers">
                                            <button class="btn pri d-block my-active"
                                                data-bs-toggle="modal"
                                                data-bs-target={`#modal-desc-${project.id}`}>
                                                Read More
                                            </button>
                                            <button class="btn sec ms-2"
                                                data-bs-toggle="modal"
                                                data-bs-target={`#modal-screens-${project.id}`}>
                                                View Screens
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal modal1 fade" id={`modal-desc-${project.id}`} tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title">{project.name}</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <img src={project.thumbnail} class="w-100" alt={project.name} />
                                        <div class="mt-4 project-description" set:html={project.description} />
                                        <div class="mt-3">
                                            <span class="text-theme fw-bold">Technologies used</span>
                                            <ul style="list-style-type:disc;">
                                                {project.techStack.map(tech => <li>{tech}</li>)}
                                            </ul>
                                        </div>
                                        {project.liveUrl && (
                                            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-lg d-block my-4 mx-auto">
                                                Visit Website
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal modal2 fade" id={`modal-screens-${project.id}`} tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5">{project.name} Screens</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div id={`carousel-${project.id}`} class="carousel slide carousel-fade" data-bs-ride="carousel">
                                            <div class="carousel-inner">
                                                {project.screens.map((screen, idx) => (
                                                    <div class={`carousel-item${idx === 0 ? ' active' : ''}`}>
                                                        <img src={screen.src} class="d-block w-100" alt={screen.alt} />
                                                    </div>
                                                ))}
                                            </div>
                                            <button class="carousel-control-prev" type="button" data-bs-target={`#carousel-${project.id}`} data-bs-slide="prev">
                                                <span class="fa fa-angle-left text-theme fs-5" aria-hidden="true"></span>
                                                <span class="visually-hidden">Previous</span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target={`#carousel-${project.id}`} data-bs-slide="next">
                                                <span class="fa fa-angle-right text-theme fs-5" aria-hidden="true"></span>
                                                <span class="visually-hidden">Next</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </>
                ))}
            </div>

            <!-- App Projects -->
            <div id="app-dev-projects" class="row px-0 mx-0">
                {appProjects.map((project) => (
                    <>
                        <div class="col-12 col-md-6 col-lg-6 col-xl-4 mb-3">
                            <div class="project-item card rounded-5"
                                data-ribbon={project.ribbon}
                                style="--d:6px;--f:10px;--c:var(--theme-color)">
                                <div class="card-body">
                                    <div class="project-image">
                                        <img src={project.thumbnail} width="100%" height="100%"
                                            class="d-block h100p w-100" alt={project.name} />
                                    </div>
                                    <div class="overlay project-description">
                                        <h6 class="fw-bold text-white">{project.name}</h6>
                                        <p class="mt-3 text-white">{project.tagline}</p>
                                        <div class="around btn-containers">
                                            <button class="btn pri d-block my-active"
                                                data-bs-toggle="modal"
                                                data-bs-target={`#modal-desc-${project.id}`}>
                                                Read More
                                            </button>
                                            <button class="btn sec ms-2"
                                                data-bs-toggle="modal"
                                                data-bs-target={`#modal-screens-${project.id}`}>
                                                View Screens
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal modal1 fade" id={`modal-desc-${project.id}`} tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title">{project.name}</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <img src={project.thumbnail} class="w-100" alt={project.name} />
                                        <div class="mt-4 project-description" set:html={project.description} />
                                        <div class="mt-3">
                                            <span class="text-theme fw-bold">Technologies used</span>
                                            <ul style="list-style-type:disc;">
                                                {project.techStack.map(tech => <li>{tech}</li>)}
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal modal2 fade" id={`modal-screens-${project.id}`} tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5">{project.name} Screens</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div id={`carousel-${project.id}`} class="carousel slide" data-bs-ride="carousel">
                                            <div class="carousel-inner">
                                                {project.screens.map((screen, idx) => (
                                                    <div class={`carousel-item${idx === 0 ? ' active' : ''}`}>
                                                        <img src={screen.src} class="d-block mx-auto maxh400" alt={screen.alt} />
                                                    </div>
                                                ))}
                                            </div>
                                            <button class="carousel-control-prev" type="button" data-bs-target={`#carousel-${project.id}`} data-bs-slide="prev">
                                                <i class="icon-arrow-left" aria-hidden="true"></i>
                                                <span class="visually-hidden">Previous</span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target={`#carousel-${project.id}`} data-bs-slide="next">
                                                <i class="icon-arrow-right" aria-hidden="true"></i>
                                                <span class="visually-hidden">Next</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </>
                ))}
            </div>

            <!-- Game Projects -->
            <div id="game-dev-projects" class="row px-0 d-none mx-0">
                {gameProjects.map((project) => (
                    <>
                        <div class="col-12 col-md-6 col-lg-6 col-xl-4 mb-3">
                            <div class="project-item card rounded-5"
                                data-ribbon={project.ribbon}
                                style="--d:6px;--f:10px;--c:var(--theme-color)">
                                <div class="card-body">
                                    <div class="project-image">
                                        <img src={project.thumbnail} width="100%" height="100%"
                                            class="d-block h100p w-100" alt={project.name} />
                                    </div>
                                    <div class="overlay project-description">
                                        <h6 class="fw-bold text-white">{project.name}</h6>
                                        <p class="mt-3 text-white">{project.tagline}</p>
                                        <div class="around btn-containers">
                                            <button class="btn pri d-block my-active"
                                                data-bs-toggle="modal"
                                                data-bs-target={`#modal-desc-${project.id}`}>
                                                Read More
                                            </button>
                                            {project.gameVideos && project.gameVideos.length > 0 && (
                                                <button class="btn sec ms-2"
                                                    data-bs-toggle="modal"
                                                    data-bs-target={`#modal-screens-${project.id}`}>
                                                    View Game Play
                                                </button>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Description Modal -->
                        <div class="modal modal1 fade" id={`modal-desc-${project.id}`} tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title">{project.name}</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mt-4 project-description" set:html={project.description} />
                                        <div class="mt-3">
                                            <span class="text-theme fw-bold">Technologies used</span>
                                            <ul style="list-style-type:disc;">
                                                {project.techStack.map(tech => <li>{tech}</li>)}
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Gameplay Videos Modal -->
                        {project.gameVideos && project.gameVideos.length > 0 && (
                            <div class="modal modal2 fade" id={`modal-screens-${project.id}`} tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5">{project.name} Game Play</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            {project.gameVideos.map((vid) => (
                                                <>
                                                    <span class="text-theme text-center fs-3 fw-bold d-block my-2">{vid.label}</span>
                                                    <video style="height:100%;width:100%;" src={vid.src} autoplay controls></video>
                                                </>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        )}
                    </>
                ))}
            </div>

        </div>
    </div>


</div>

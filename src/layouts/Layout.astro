<body>
    <slot />

    <script>
        (window as any).removeLoading = function () {
            const l = document.getElementById("loading");
            const p = document.getElementById("page");
            if (l) l.className = 'd-none';
            if (p) p.className = '';
        };

        (window as any).downloadCv = function () {
            const link = document.getElementById('download-cv-link') as HTMLAnchorElement;
            link?.click();
        };

        const loading = document.getElementById("loading");
        if (loading) {
            setTimeout(() => {
                loading.innerHTML += `
                    <h4 class="text-info text-center mx-auto px-3 fs-6 fadeIn">Slow internet connection is observed, please wait patiently</h4>
                    <button class="btn btn-info fadeIn mt-4" style="font-size:1rem;padding:0.375rem 0.75rem;" onclick="window.removeLoading()">
                        Disable Loading
                    </button>
                `;
            }, 4000);
        }

        window.addEventListener('load', () => {
            (window as any).removeLoading();
        });
    </script>

    <script is:inline src="/assets/js/bootstrap.js"></script>
